datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  client
}

enum UserStatus {
  active
  locked
}

model User {
  id                  Int                  @id @default(autoincrement())
  code                String?              @unique @map("code") @db.VarChar(20)
  email               String               @unique
  password            String?
  name                String?
  role                Role                 @default(client)
  status              UserStatus           @default(active)
  googleId            String?              @unique @map("google_id")
  avatarUrl           String?              @map("avatar_url")
  provider            String               @default("credentials")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  refreshTokens       RefreshToken[]
  blogs               Blog[]
  subscriptions       UserSubscription[]
  paymentTransactions PaymentTransaction[]
  approvedTransactions PaymentTransaction[] @relation("AdminApprovedTransactions")
  refunds             PaymentRefund[]      @relation("AdminRefunds")
  createdSubscriptions UserSubscription[]  @relation("AdminCreatedSubscriptions")
  conversations        SupportConversation[] @relation("UserConversations")
  assignedConversations SupportConversation[] @relation("AgentConversations")
  createdTickets       SupportTicket[]       @relation("CreatedTickets")
  assignedTickets      SupportTicket[]       @relation("AssignedTickets")
  ticketComments       SupportTicketComment[]
  notifications        Notification[]
  videos               Video[]
  uploadSessions       UploadSession[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(500)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

model BlogType {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  blogs       Blog[]

  @@map("blog_types")
}

model Blog {
  id           Int       @id @default(autoincrement())
  code         String?   @unique @map("code") @db.VarChar(30)
  title        String
  slug         String    @unique
  blogTypeId   Int       @map("blog_type_id")
  bannerUrl    String?   @map("banner_url") @db.LongText
  thumbnailUrl String?   @map("thumbnail_url") @db.LongText
  isPremium    Boolean   @default(false) @map("is_premium")
  summary      String?   @db.Text
  content      String?   @db.Text
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    Int?      @map("created_by")
  status       String    @default("draft")

  blogType BlogType @relation(fields: [blogTypeId], references: [id])
  creator  User?    @relation(fields: [createdBy], references: [id])

  @@map("blogs")
}

model VideoType {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  videos Video[]

  @@map("video_types")
}

model Video {
  id             String    @id @default(uuid()) @db.VarChar(36)
  code           String    @unique @map("code") @db.VarChar(50)
  title          String    @db.VarChar(255)
  slug           String    @unique @db.VarChar(255)
  description    String?   @db.LongText
  sourceType     String    @default("youtube") @map("source_type") @db.VarChar(50)
  youtubeVideoId String?   @map("youtube_video_id") @db.VarChar(100)
  storagePath    String?   @map("storage_path") @db.VarChar(500)
  duration       Int       @default(0) @map("duration")
  teaserDuration Int       @default(0) @map("teaser_duration")
  thumbnailUrl   String?   @map("thumbnail_url") @db.LongText
  isPremium      Boolean   @default(false) @map("is_premium")
  status         String    @default("draft") @db.VarChar(30)
  processStatus  String    @default("ready") @map("process_status") @db.VarChar(30)
  videoTypeId    Int       @map("video_type_id")
  createdBy      Int?      @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  videoType VideoType @relation(fields: [videoTypeId], references: [id])
  creator   User?     @relation(fields: [createdBy], references: [id])

  @@map("videos")
}

enum BillingCycle {
  monthly
  yearly
}

model MembershipPlan {
  id                    Int                     @id @default(autoincrement())
  code                  String                  @unique @db.VarChar(50)
  name                  String                  @db.VarChar(100)
  tagLine               String?                 @map("tag_line") @db.VarChar(255)
  monthlyPrice          Decimal                 @default(0) @map("monthly_price") @db.Decimal(12, 2)
  yearlyPrice           Decimal                 @default(0) @map("yearly_price") @db.Decimal(12, 2)
  yearlyDiscountPercent Decimal                 @default(0) @map("yearly_discount_percent") @db.Decimal(5, 2)
  popularBadge          String?                 @map("popular_badge") @db.VarChar(100)
  buttonText            String?                 @map("button_text") @db.VarChar(100)
  tierLevel             Int                     @default(1) @map("tier_level")
  isActive              Boolean                 @default(true) @map("is_active")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  subscriptions         UserSubscription[]
  planFeatures          MembershipPlanFeature[]
  paymentTransactions   PaymentTransaction[]

  @@map("membership_plans")
}

model Feature {
  id          Int                     @id @default(autoincrement())
  code        String                  @unique @db.VarChar(50)
  name        String                  @db.VarChar(100)
  description String?                 @db.Text
  sortOrder   Int                     @default(0) @map("sort_order")
  isActive    Boolean                 @default(true) @map("is_active")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  plans       MembershipPlanFeature[]

  @@map("features")
}

model MembershipPlanFeature {
  planId      Int            @map("plan_id")
  featureId   Int            @map("feature_id")
  isAvailable Boolean        @default(true) @map("is_available")
  disabledAt  DateTime?      @map("disabled_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  plan        MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature     Feature        @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@map("membership_plan_features")
}

enum SubscriptionCreatedType {
  system
  admin
}

model UserSubscription {
  id            Int                     @id @default(autoincrement())
  code          String                  @unique @db.VarChar(50)
  userId        Int                     @map("user_id")
  planId        Int                     @map("plan_id")
  billingCycle  BillingCycle            @default(monthly) @map("billing_cycle")
  startDate     DateTime                @map("start_date")
  endDate       DateTime                @map("end_date")
  pricePaid     Decimal                 @map("price_paid") @db.Decimal(12, 2)
  paymentMethod String?                 @map("payment_method") @db.VarChar(50)
  paymentRef    String?                 @map("payment_ref") @db.VarChar(100)
  createdType   SubscriptionCreatedType @default(system) @map("created_type")
  createdBy     Int?                    @map("created_by")
  notes         String?                 @db.Text
  proofUrls     Json?                   @map("proof_urls")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          MembershipPlan          @relation(fields: [planId], references: [id])
  createdByUser User?                   @relation("AdminCreatedSubscriptions", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("user_subscriptions")
}

model PaymentAccount {
  id                  Int                  @id @default(autoincrement())
  bankCode            String               @map("bank_code") @db.VarChar(50)
  bank                VietqrBank?          @relation(fields: [bankCode], references: [code])
  accountNo           String               @map("account_no") @db.VarChar(50)
  accountHolder       String               @map("account_holder") @db.VarChar(100)
  qrCodeUrl           String?              @map("qr_code_url") @db.VarChar(500)
  isDefault           Boolean              @default(false) @map("is_default")
  note                String?              @db.Text
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  paymentTransactions PaymentTransaction[]

  @@map("payment_accounts")
}

model VietqrBank {
  id                Int              @id
  name              String           @db.VarChar(255)
  shortName         String           @map("short_name") @db.VarChar(100)
  code              String           @unique @db.VarChar(50)
  bin               String           @db.VarChar(20)
  logo              String?          @db.VarChar(500)
  transferSupported Int              @default(1) @map("transfer_supported")
  lookupSupported   Int              @default(1) @map("lookup_supported")
  isActive          Boolean          @default(true) @map("is_active")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  paymentAccounts   PaymentAccount[]

  @@map("vietqr_banks")
}

enum ApprovalType {
  auto
  manual
}

enum PaymentTransactionStatus {
  pending
  partially_paid
  completed
  overpaid
  expired
  cancelled
}

enum RefundStatus {
  none
  unrefunded
  partially_refunded
  fully_refunded
}

model PaymentTransaction {
  id               Int                      @id @default(autoincrement())
  code             String                   @unique @db.VarChar(50)
  orderCode        String?                  @map("order_code") @db.VarChar(50)
  userId           Int                      @map("user_id")
  planId           Int                      @map("plan_id")
  paymentAccountId Int?                     @map("payment_account_id")
  billingCycle     BillingCycle             @default(monthly) @map("billing_cycle")
  amount           Decimal                  @db.Decimal(12, 2)
  paidAmount       Decimal                  @default(0) @map("paid_amount") @db.Decimal(12, 2)
  paymentMethod    String                   @default("vietqr") @map("payment_method") @db.VarChar(50)
  transferContent  String                   @map("transfer_content") @db.VarChar(100)
  status           PaymentTransactionStatus @default(pending)
  refundStatus     RefundStatus             @default(none) @map("refund_status")
  approvalType     ApprovalType             @default(auto) @map("approval_type")
  approvedBy       Int?                     @map("approved_by")
  bankCode         String?                  @map("bank_code") @db.VarChar(50)
  accountNo        String?                  @map("account_no") @db.VarChar(50)
  accountHolder    String?                  @map("account_holder") @db.VarChar(100)
  qrCodeUrl        String?                  @map("qr_code_url") @db.VarChar(500)
  paymentRef       String?                  @map("payment_ref") @db.VarChar(100)
  notes            String?                  @map("notes") @db.Text
  expiredAt        DateTime                 @map("expired_at")
  paidAt           DateTime?                @map("paid_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           MembershipPlan  @relation(fields: [planId], references: [id])
  paymentAccount PaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  approvedByUser User?           @relation("AdminApprovedTransactions", fields: [approvedBy], references: [id], onDelete: SetNull)
  refunds        PaymentRefund[]

  @@index([status, refundStatus])
  @@map("payment_transactions")
}

model PaymentRefund {
  id          Int                @id @default(autoincrement())
  code        String             @unique @db.VarChar(50)
  paymentTxId Int                @map("payment_tx_id")
  amount      Decimal            @db.Decimal(12, 2)
  refundRef   String?            @map("refund_ref") @db.VarChar(100)
  proofUrls   Json?              @map("proof_urls")
  notes       String?            @db.Text
  refundedBy  Int?               @map("refunded_by")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  paymentTransaction PaymentTransaction @relation(fields: [paymentTxId], references: [id], onDelete: Cascade)
  refundedByUser     User?              @relation("AdminRefunds", fields: [refundedBy], references: [id], onDelete: SetNull)

  @@map("payment_refunds")
}

model PaymentMethod {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(255)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("payment_methods")
}

enum ConversationStatus {
  BOT
  WAITING_AGENT
  AGENT_HANDLING
  RESOLVED
  CONVERTED_TO_TICKET
}

enum SenderType {
  USER
  BOT
  AGENT
  SYSTEM
}

enum TicketCategory {
  PAYMENT
  ACCOUNT
  TECHNICAL
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_USER
  RESOLVED
  CLOSED
}

model SupportConversation {
  id           Int                @id @default(autoincrement())
  code         String             @unique @map("code") @db.VarChar(50)
  userId       Int                @map("user_id")
  assignedTo   Int?               @map("assigned_to")
  status       ConversationStatus @default(WAITING_AGENT) @map("status")
  lastMessage      String?            @map("last_message") @db.Text
  lastSender       SenderType?        @map("last_sender")
  userUnreadCount  Int                @default(0) @map("user_unread_count")
  agentUnreadCount Int                @default(0) @map("agent_unread_count")
  closedAt         DateTime?          @map("closed_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user     User             @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)
  agent    User?            @relation("AgentConversations", fields: [assignedTo], references: [id], onDelete: SetNull)
  messages SupportMessage[]
  ticket   SupportTicket?

  @@index([userId, status])
  @@index([assignedTo, status])
  @@map("support_conversations")
}

model SupportMessage {
  id             Int                 @id @default(autoincrement())
  conversationId Int                 @map("conversation_id")
  senderType     SenderType          @map("sender_type")
  senderId       Int?                @map("sender_id")
  content        String              @map("content") @db.Text
  metadata       Json?               @map("metadata")
  attachments    Json?               @map("attachments")
  isSystemNotice Boolean             @default(false) @map("is_system_notice")
  createdAt      DateTime            @default(now()) @map("created_at")

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("support_messages")
}

model SupportTicket {
  id                   Int                  @id @default(autoincrement())
  code                 String               @unique @map("code") @db.VarChar(50)
  title                String               @map("title") @db.VarChar(255)
  description          String               @map("description") @db.Text
  category             TicketCategory       @default(OTHER) @map("category")
  priority             TicketPriority       @default(MEDIUM) @map("priority")
  status               TicketStatus         @default(OPEN) @map("status")
  creatorId            Int                  @map("creator_id")
  assigneeId           Int?                 @map("assignee_id")
  sourceConversationId Int?                 @unique @map("source_conversation_id")
  creatorUnreadCount   Int                  @default(0) @map("creator_unread_count")
  assigneeUnreadCount  Int                  @default(0) @map("assignee_unread_count")
  resolvedAt           DateTime?            @map("resolved_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  creator            User                  @relation("CreatedTickets", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee           User?                 @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: SetNull)
  sourceConversation SupportConversation?  @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)
  comments           SupportTicketComment[]

  @@index([creatorId, status])
  @@index([assigneeId, status])
  @@index([category, priority, status])
  @@map("support_tickets")
}

model SupportTicketComment {
  id          Int           @id @default(autoincrement())
  ticketId    Int           @map("ticket_id")
  senderId    Int           @map("sender_id")
  content     String        @map("content") @db.Text
  attachments Json?         @map("attachments")
  createdAt   DateTime      @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_ticket_comments")
}

enum NotificationType {
  TICKET_CREATED
  TICKET_REPLIED
  TICKET_STATUS_CHANGED
  SYSTEM
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  title     String           @db.VarChar(255)
  content   String           @db.Text
  type      NotificationType @default(SYSTEM)
  link      String?          @db.VarChar(500)
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([isRead, readAt])
  @@map("notifications")
}

model UploadSession {
  id           String   @id @default(uuid()) @db.VarChar(36)
  bunnyVideoId String   @unique @map("bunny_video_id") @db.VarChar(100)
  userId       Int?     @map("user_id")
  status       String   @default("PENDING") @db.VarChar(30)
  title        String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("upload_sessions")
}







