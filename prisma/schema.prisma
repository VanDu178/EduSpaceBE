datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  client
}

enum UserStatus {
  active
  locked
}

model User {
  id            Int            @id @default(autoincrement())
  code          String?        @unique @map("code") @db.VarChar(20)
  email         String         @unique
  password      String?
  name          String?
  role          Role           @default(client)
  status        UserStatus     @default(active)
  googleId      String?        @unique @map("google_id")
  avatarUrl     String?        @map("avatar_url")
  provider      String         @default("credentials")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  blogs         Blog[]
  subscriptions UserSubscription[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(500)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

model BlogType {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  blogs       Blog[]

  @@map("blog_types")
}

model Blog {
  id           Int       @id @default(autoincrement())
  code         String?   @unique @map("code") @db.VarChar(30)
  title        String
  slug         String    @unique
  blogTypeId   Int       @map("blog_type_id")
  bannerUrl    String?   @map("banner_url") @db.LongText
  thumbnailUrl String?   @map("thumbnail_url") @db.LongText
  isPremium    Boolean   @default(false) @map("is_premium")
  summary      String?   @db.Text
  content      String?   @db.Text
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    Int?      @map("created_by")
  status       String    @default("draft")

  blogType BlogType @relation(fields: [blogTypeId], references: [id])
  creator  User?    @relation(fields: [createdBy], references: [id])

  @@map("blogs")
}

enum SubscriptionStatus {
  active
  expired
  cancelled
  pending_payment @map("pending_payment")
}

enum BillingCycle {
  monthly
  yearly
}

model MembershipPlan {
  id            Int                @id @default(autoincrement())
  code          String             @unique @db.VarChar(50)
  name          String             @db.VarChar(100)
  tagLine       String?            @map("tag_line") @db.VarChar(255)
  monthlyPrice  Decimal            @default(0) @map("monthly_price") @db.Decimal(12, 2)
  yearlyPrice   Decimal            @default(0) @map("yearly_price") @db.Decimal(12, 2)
  popularBadge  String?            @map("popular_badge") @db.VarChar(100)
  buttonText    String?            @map("button_text") @db.VarChar(100)
  features            Json?
  unavailableFeatures Json?              @map("unavailable_features")
  sortOrder     Int                @default(0) @map("sort_order")
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  subscriptions UserSubscription[]

  @@map("membership_plans")
}

model UserSubscription {
  id            Int                @id @default(autoincrement())
  code          String             @unique @db.VarChar(50)
  userId        Int                @map("user_id")
  planId        Int                @map("plan_id")
  billingCycle  BillingCycle       @default(monthly) @map("billing_cycle")
  startDate     DateTime           @map("start_date")
  endDate       DateTime           @map("end_date")
  status        SubscriptionStatus @default(active)
  pricePaid     Decimal            @map("price_paid") @db.Decimal(12, 2)
  paymentMethod String?            @map("payment_method") @db.VarChar(50)
  paymentRef    String?            @map("payment_ref") @db.VarChar(100)
  autoRenew     Boolean            @default(false) @map("auto_renew")
  cancelledAt   DateTime?          @map("cancelled_at")
  cancelReason  String?            @map("cancel_reason") @db.VarChar(255)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          MembershipPlan     @relation(fields: [planId], references: [id])

  @@map("user_subscriptions")
}

